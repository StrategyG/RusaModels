# Local development only. Replace all values before use.
RUSAMODELS_ENV=development
DATABASE_URL=postgresql+psycopg://rusamodels:rusamodels_dev_only_change_me@localhost:5432/rusamodels
STORAGE_BACKEND=s3
LOCAL_STORAGE_PATH=.local/artifacts
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=rusamodels-artifacts
S3_ACCESS_KEY_ID=rusamodels_minio
S3_SECRET_ACCESS_KEY=rusamodels_minio_dev_only_change_me
RUSAMODELS_API_PRINCIPALS={}
RUSAMODELS_SERVICE_TOKEN_SHA256=
MAX_UPLOAD_BYTES=10737418240
HF_TOKEN=
RUSAMODELS_WORKER_POLL_SECONDS=5
# Optional Model Server OpenAI-compatible runtime
# Set both URL and model ID to enable /openai/v1 endpoints.
RUSAMODELS_INFERENCE_BASE_URL=
RUSAMODELS_INFERENCE_MODEL_ID=
RUSAMODELS_INFERENCE_API_KEY=
RUSAMODELS_INFERENCE_TIMEOUT_SECONDS=300

# Optional independent local embedding runtime (Codespaces CPU profile).
RUSAMODELS_EMBEDDING_BASE_URL=
RUSAMODELS_EMBEDDING_MODEL_ID=
RUSAMODELS_EMBEDDING_API_KEY=
RUSAMODELS_EMBEDDING_TIMEOUT_SECONDS=120

# CPU inference Codespaces profile. Keep model files outside Git.
RUSAMODELS_GGUF_MODEL_PATH=/workspaces/RusaModels/.local/models/rusa-general-4b/model-q5_k_m.gguf
RUSAMODELS_GGUF_MODEL_SHA256=
RUSAMODELS_EMBEDDING_MODEL_PATH=/workspaces/RusaModels/.local/models/multilingual-e5-small
RUSAMODELS_EMBEDDING_INTERNAL_TOKEN=
RUSAMODELS_MODEL_CONTEXT=4096
RUSAMODELS_CPU_THREADS=3
RUSAMODELS_LLM_MEMORY_LIMIT=8g
RUSAMODELS_LLM_CPU_LIMIT=3.0
RUSAMODELS_EMBEDDING_CPU_THREADS=1
RUSAMODELS_EMBEDDING_MEMORY_LIMIT=2g
RUSAMODELS_EMBEDDING_CPU_LIMIT=1.0
