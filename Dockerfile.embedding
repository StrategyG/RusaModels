FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 \
    HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 TOKENIZERS_PARALLELISM=false \
    HOME=/tmp/home HF_HOME=/tmp/hf SENTENCE_TRANSFORMERS_HOME=/tmp/sentence-transformers \
    OMP_NUM_THREADS=1 MKL_NUM_THREADS=1
WORKDIR /app
RUN groupadd --gid 1000 app && useradd --uid 1000 --gid app --create-home --shell /usr/sbin/nologin app
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu "torch>=2.4,<3"
RUN pip install --no-cache-dir "fastapi>=0.115,<1" "uvicorn[standard]>=0.34,<1" "sentence-transformers>=3,<6"
COPY services/embedding_server ./services/embedding_server
RUN chown -R app:app /app
USER app
EXPOSE 8081
HEALTHCHECK --interval=30s --timeout=5s --start-period=180s --retries=3 CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8081/health/live', timeout=3)"
CMD ["uvicorn", "services.embedding_server.app.main:app", "--host", "0.0.0.0", "--port", "8081"]
