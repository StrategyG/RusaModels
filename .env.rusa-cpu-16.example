# RusaAi Architecture v2.0 — native Windows 11 RUSA-CPU-16 edge profile.
# Deployment remains blocked until a compatible non-Qwen checkpoint is selected,
# tokenizer/chat template are validated, and a Q4_K_M GGUF artifact is built.
RUSAMODELS_ENV=edge
DATABASE_URL=sqlite:///./.local/rusamodels.db
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=.local/artifacts
RUSAMODELS_API_PRINCIPALS={"replace-with-64-char-lowercase-sha256":{"subject":"rusa-ai-inference","role":"inference"}}
RUSAMODELS_SERVICE_TOKEN_SHA256=replace-with-64-char-lowercase-sha256
RUSAMODELS_INFERENCE_BASE_URL=http://127.0.0.1:8081
RUSAMODELS_INFERENCE_MODEL_ID=rusaai-edge-1.54b
RUSAMODELS_INFERENCE_TIMEOUT_SECONDS=360
RUSAMODELS_INFERENCE_API_KEY=
RUSAMODELS_EMBEDDING_BASE_URL=
RUSAMODELS_EMBEDDING_MODEL_ID=
RUSAMODELS_EMBEDDING_API_KEY=
RUSAMODELS_GGUF_MODEL_PATH=
RUSAMODELS_GGUF_MODEL_SHA256=
RUSAMODELS_CONTEXT_SIZE=4096
RUSAMODELS_CONTEXT_8K_TEST_MODE=false
RUSAMODELS_MODEL_MANIFEST=models/rusaai-edge/manifests/0.1.0-design.json
LLAMA_SERVER_EXE=
