{
  "name": "RusaModels — Quant Server",
  "dockerComposeFile": ["../docker-compose.codespaces.yml"],
  "service": "quant-server",
  "workspaceFolder": "/workspace",
  "runServices": ["quant-server", "quant-worker"],
  "overrideCommand": false,
  "shutdownAction": "stopCompose",
  "hostRequirements": { "cpus": 4, "memory": 16, "storage": 32 },
  "postCreateCommand": "python -m pip install --user -e '.[dev]'",
  "forwardPorts": [8001],
  "portsAttributes": { "8001": { "label": "RusaModels Quant Server", "onAutoForward": "notify" } },
  "customizations": { "vscode": { "extensions": ["ms-python.python", "charliermarsh.ruff"] } }
}
