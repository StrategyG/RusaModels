{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rusamodels.local/schemas/tokenizers/tokenizer-artifact-manifest.schema.json",
  "title": "RusaModels Tokenizer Artifact Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "tokenizer_id", "tokenizer_version", "algorithm",
    "tokenizer_file", "tokenizer_sha256", "tokenizer_size_bytes", "vocab_size",
    "special_tokens", "training_corpus", "trainer", "created_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "tokenizer_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "tokenizer_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "algorithm": {"const": "byte_level_bpe"},
    "tokenizer_file": {"const": "tokenizer.json"},
    "tokenizer_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tokenizer_size_bytes": {"type": "integer", "minimum": 1},
    "vocab_size": {"type": "integer", "minimum": 260},
    "special_tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unk", "bos", "eos", "pad"],
      "properties": {
        "unk": {"$ref": "#/$defs/specialToken"},
        "bos": {"$ref": "#/$defs/specialToken"},
        "eos": {"$ref": "#/$defs/specialToken"},
        "pad": {"$ref": "#/$defs/specialToken"}
      }
    },
    "training_corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_id", "dataset_version", "split", "release_manifest_sha256",
        "corpus_manifest_sha256", "corpus_sha256", "corpus_size_bytes", "license_ids"
      ],
      "properties": {
        "dataset_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "dataset_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "split": {"const": "train"},
        "release_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "corpus_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "corpus_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "corpus_size_bytes": {"type": "integer", "minimum": 1},
        "license_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "trainer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested_vocab_size", "min_frequency", "pre_tokenizer", "normalizer", "library_version"],
      "properties": {
        "requested_vocab_size": {"type": "integer", "minimum": 260},
        "min_frequency": {"type": "integer", "minimum": 1},
        "pre_tokenizer": {"const": "bytelevel"},
        "normalizer": {"const": "none"},
        "library_version": {"type": "string", "minLength": 1, "maxLength": 32}
      }
    },
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "specialToken": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token", "id"],
      "properties": {
        "token": {"type": "string", "minLength": 1, "maxLength": 32},
        "id": {"type": "integer", "minimum": 0}
      }
    }
  }
}
