{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rusamodels.local/schemas/tokenizers/tokenizer-training-config.schema.json",
  "title": "RusaAi Research BPE Tokenizer Training Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "tokenizer_id", "tokenizer_version", "algorithm",
    "vocab_size", "min_frequency", "special_tokens", "training_split",
    "pre_tokenizer", "normalizer", "notes"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "tokenizer_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "tokenizer_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "algorithm": {"const": "byte_level_bpe"},
    "vocab_size": {"type": "integer", "minimum": 260},
    "min_frequency": {"type": "integer", "minimum": 1},
    "special_tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unk", "bos", "eos", "pad"],
      "properties": {
        "unk": {"const": "[UNK]"},
        "bos": {"const": "[BOS]"},
        "eos": {"const": "[EOS]"},
        "pad": {"const": "[PAD]"}
      }
    },
    "training_split": {"const": "train"},
    "pre_tokenizer": {"const": "bytelevel"},
    "normalizer": {"const": "none"},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
