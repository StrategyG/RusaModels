{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rusamodels.local/schemas/llm/frozen-evaluation-manifest.schema.json",
  "title": "RusaModels Frozen Evaluation Dataset Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "purpose",
    "dataset_id",
    "dataset_version",
    "locked",
    "file",
    "sha256",
    "size_bytes",
    "records",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "purpose": {"const": "frozen_evaluation"},
    "dataset_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "dataset_version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "locked": {"const": true},
    "file": {"type": "string", "minLength": 1, "pattern": "^[^/\\\\\\\\]+$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "size_bytes": {"type": "integer", "minimum": 1},
    "records": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
