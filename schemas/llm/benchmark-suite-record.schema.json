{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rusamodels.local/schemas/benchmark-suite-record.schema.json",
  "title": "RusaModels Benchmark Suite Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "category", "messages", "scorer"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "content"],
        "properties": {
          "role": {
            "type": "string",
            "enum": ["system", "user", "assistant"]
          },
          "content": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "scorer": {
      "type": "string",
      "enum": [
        "exact_match",
        "contains",
        "regex",
        "contains_all",
        "contains_any",
        "json_valid",
        "manual"
      ]
    },
    "expected": {
      "oneOf": [
        {"type": "string"},
        {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      ]
    }
  }
}
