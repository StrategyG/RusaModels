{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rusamodels.local/schemas/benchmark-suite-manifest.schema.json",
  "title": "RusaModels Frozen Benchmark Suite Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite_id",
    "suite_version",
    "frozen",
    "file_name",
    "file_sha256",
    "size_bytes",
    "record_count",
    "license_ids"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "suite_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "suite_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "frozen": {"const": true},
    "file_name": {"type": "string", "minLength": 1},
    "file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "size_bytes": {"type": "integer", "minimum": 1},
    "record_count": {"type": "integer", "minimum": 1},
    "license_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "source_uri": {"type": ["string", "null"], "maxLength": 2048},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
