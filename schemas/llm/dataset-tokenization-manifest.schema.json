{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rusamodels.local/schemas/llm/dataset-tokenization-manifest.schema.json",
  "title": "RusaModels Tokenized Dataset Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tokenizer",
    "dataset_id",
    "dataset_version",
    "split",
    "release_manifest_sha256",
    "source_split_file",
    "source_split_sha256",
    "tokenizer_id",
    "tokenizer_revision",
    "tokenizer_sha256",
    "vocab_size",
    "sequence_length",
    "add_bos",
    "add_eos",
    "bos_token_id",
    "eos_token_id",
    "pad_token_id",
    "records",
    "sequences",
    "tokens",
    "padding_tokens",
    "encoding",
    "output_file",
    "output_sha256",
    "output_size_bytes"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "tokenizer": {"const": "rusamodels.local_hf_tokenizer"},
    "dataset_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "dataset_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "split": {"type": "string", "enum": ["train", "validation", "test"]},
    "release_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_split_file": {"type": "string", "minLength": 1},
    "source_split_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tokenizer_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "tokenizer_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "tokenizer_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "vocab_size": {"type": "integer", "minimum": 1},
    "sequence_length": {"type": "integer", "minimum": 2, "maximum": 65536},
    "add_bos": {"type": "boolean"},
    "add_eos": {"type": "boolean"},
    "bos_token_id": {"type": ["integer", "null"], "minimum": 0},
    "eos_token_id": {"type": ["integer", "null"], "minimum": 0},
    "pad_token_id": {"type": "integer", "minimum": 0},
    "records": {"type": "integer", "minimum": 1},
    "sequences": {"type": "integer", "minimum": 1},
    "tokens": {"type": "integer", "minimum": 1},
    "padding_tokens": {"type": "integer", "minimum": 0},
    "encoding": {"const": "jsonl-int64"},
    "output_file": {"type": "string", "minLength": 1},
    "output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "output_size_bytes": {"type": "integer", "minimum": 1}
  }
}
