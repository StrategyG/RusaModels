{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rusamodels.local/schemas/llm/frozen-evaluation-record.schema.json",
  "title": "RusaModels Frozen Evaluation Prompt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "domain",
    "language",
    "prompt",
    "expected_outcome",
    "rubric",
    "provenance",
    "source_refs",
    "risk_class"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "id": {"type": "string", "pattern": "^record_[0-9a-f]{24}$"},
    "domain": {
      "type": "string",
      "enum": [
        "indonesian_instruction",
        "english_bilingual",
        "reasoning_problem_solving",
        "coding_debugging",
        "architecture_devops",
        "tool_json_contracts",
        "rag_grounding_attribution",
        "safety_prompt_injection"
      ]
    },
    "language": {"type": "string", "enum": ["id", "en", "mixed"]},
    "prompt": {"type": "string", "minLength": 1, "maxLength": 20000},
    "expected_outcome": {"type": "string", "minLength": 1, "maxLength": 8000},
    "rubric": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "weight", "pass_condition"],
        "properties": {
          "criterion": {"type": "string", "minLength": 1, "maxLength": 160},
          "weight": {"type": "integer", "minimum": 1, "maximum": 5},
          "pass_condition": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    },
    "provenance": {
      "type": "string",
      "enum": ["project_owned", "licensed_source", "human_authored", "synthetic"]
    },
    "source_refs": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "revision", "locator", "sha256"],
        "properties": {
          "source_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
          "revision": {"type": "string", "minLength": 1, "maxLength": 128},
          "locator": {"type": "string", "minLength": 1, "maxLength": 1024},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "risk_class": {"type": "string", "enum": ["low", "medium", "high", "critical"]}
  },
  "allOf": [
    {
      "if": {"properties": {"provenance": {"enum": ["project_owned", "licensed_source"]}}},
      "then": {"properties": {"source_refs": {"minItems": 1}}}
    }
  ]
}
