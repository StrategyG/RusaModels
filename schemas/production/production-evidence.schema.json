{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rusamodels.local/schemas/production-evidence.schema.json",
  "title": "RusaModels Production Readiness Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release",
    "ci",
    "security",
    "model",
    "evaluation",
    "runtime",
    "soak",
    "backup_restore",
    "rollback",
    "deployment"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_id",
        "git_commit_sha",
        "container_image_digest",
        "deployment_config_sha256",
        "model_id",
        "model_version",
        "model_artifact_sha256"
      ],
      "properties": {
        "release_id": {"type": "string", "minLength": 1},
        "git_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "container_image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "deployment_config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "model_id": {"type": "string", "minLength": 1},
        "model_version": {"type": "string", "minLength": 1},
        "model_artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "ci": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit_sha", "conclusion", "required_checks_passed", "run_url"],
      "properties": {
        "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "conclusion": {"const": "success"},
        "required_checks_passed": {"const": true},
        "run_url": {"type": "string", "format": "uri"}
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "critical_findings", "high_findings", "secret_findings", "report_url"],
      "properties": {
        "status": {"const": "passed"},
        "critical_findings": {"type": "integer", "const": 0},
        "high_findings": {"type": "integer", "const": 0},
        "secret_findings": {"type": "integer", "const": 0},
        "report_url": {"type": "string", "format": "uri"}
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "model_version", "artifact_sha256", "manifest_sha256", "lifecycle_status"],
      "properties": {
        "model_id": {"type": "string", "minLength": 1},
        "model_version": {"type": "string", "minLength": 1},
        "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "lifecycle_status": {"const": "approved"}
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "model_version", "artifact_sha256", "benchmark_gate_passed", "safety_gate_passed", "regression_gate_passed", "report_sha256"],
      "properties": {
        "model_id": {"type": "string", "minLength": 1},
        "model_version": {"type": "string", "minLength": 1},
        "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "benchmark_gate_passed": {"const": true},
        "safety_gate_passed": {"const": true},
        "regression_gate_passed": {"const": true},
        "report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_artifact_sha256", "health_check_passed", "cpu_only", "oom_events", "hardware_profile", "peak_ram_mb", "free_ram_reserve_mb", "ttft_ms", "tokens_per_second", "benchmark_report_url"],
      "properties": {
        "model_artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "health_check_passed": {"const": true},
        "cpu_only": {"const": true},
        "oom_events": {"type": "integer", "const": 0},
        "hardware_profile": {"type": "string", "minLength": 1},
        "peak_ram_mb": {"type": "number", "exclusiveMinimum": 0},
        "free_ram_reserve_mb": {"type": "number", "exclusiveMinimum": 0},
        "ttft_ms": {"type": "number", "minimum": 0},
        "tokens_per_second": {"type": "number", "exclusiveMinimum": 0},
        "benchmark_report_url": {"type": "string", "format": "uri"}
      }
    },
    "soak": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration_hours", "requests", "error_rate", "oom_events", "crash_count", "p95_latency_ms", "report_url"],
      "properties": {
        "duration_hours": {"type": "number", "minimum": 24},
        "requests": {"type": "integer", "minimum": 100},
        "error_rate": {"type": "number", "minimum": 0, "maximum": 0.001},
        "oom_events": {"type": "integer", "const": 0},
        "crash_count": {"type": "integer", "const": 0},
        "p95_latency_ms": {"type": "number", "exclusiveMinimum": 0},
        "report_url": {"type": "string", "format": "uri"}
      }
    },
    "backup_restore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["database_backup_verified", "object_storage_backup_verified", "restore_test_passed", "backup_age_hours", "report_url"],
      "properties": {
        "database_backup_verified": {"const": true},
        "object_storage_backup_verified": {"const": true},
        "restore_test_passed": {"const": true},
        "backup_age_hours": {"type": "number", "minimum": 0, "maximum": 24},
        "report_url": {"type": "string", "format": "uri"}
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["software_rollback_test_passed", "model_rollback_test_passed", "report_url"],
      "properties": {
        "software_rollback_test_passed": {"const": true},
        "model_rollback_test_passed": {"const": true},
        "report_url": {"type": "string", "format": "uri"}
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["https_enforced", "postgres_sslmode", "secrets_from_secret_manager", "object_storage_external", "persistent_storage", "monitoring_enabled", "alerting_enabled", "deployment_profile"],
      "properties": {
        "https_enforced": {"const": true},
        "postgres_sslmode": {"const": "verify-full"},
        "secrets_from_secret_manager": {"const": true},
        "object_storage_external": {"const": true},
        "persistent_storage": {"const": true},
        "monitoring_enabled": {"const": true},
        "alerting_enabled": {"const": true},
        "deployment_profile": {"type": "string", "minLength": 1}
      }
    }
  }
}
